module Lookthrough where

import DA.Time (addRelTime, days)
import DA.List (dedup)

data RightsTier = Standard | Enhanced
  deriving (Eq, Show)

data ValuationResult = ValuationResult with
    fund : ContractId Fund
    positions : [ContractId LpPosition]
  deriving (Eq, Show)

data RedemptionResult = RedemptionResult with
    position : ContractId LpPosition
    request : ContractId Redemption
  deriving (Eq, Show)

-- Record the rights reviewed at preparation time. Position replacements from
-- valuations or redemptions must not invalidate an unrelated pending draft.
data DisclosureRecipient = DisclosureRecipient with
    lp : Party
    rights : RightsTier
    policyReference : Text
  deriving (Eq, Show)

-- Only administrators see this record. Stable fundId links contract versions.
template Fund
  with
    fundId : Text
    name : Text
    gp : Party
    reviewer : Party
    auditors : [Party]
    disclosureIntervalDays : Int
    latestValuation : Optional Time
  where
    signatory gp
    observer reviewer, auditors
    ensure fundId /= "" && name /= "" && disclosureIntervalDays > 0 && reviewer /= gp

    nonconsuming choice ProposePosition : ContractId PositionProposal
      with
        lp : Party
        rights : RightsTier
        policyReference : Text
        commitment : Decimal
        units : Decimal
      controller gp
      do
        create PositionProposal with
          fundId; fundName = name; gp; lp; auditors; rights; policyReference
          commitment; units; disclosureIntervalDays

    choice StrikeValuation : ValuationResult
      with
        asOf : Time
        navPerUnit : Decimal
        distributionsPerUnit : Decimal
        feesAccruedPerUnit : Decimal
        basis : Text
        positionIds : [ContractId LpPosition]
      controller gp
      do
        now <- getTime
        assertMsg "A valuation cannot be future-dated" (asOf <= now)
        assertMsg "A valuation needs a positive NAV and a stated basis"
          (navPerUnit > 0.0 && basis /= "" && distributionsPerUnit >= 0.0 && feesAccruedPerUnit >= 0.0)
        case latestValuation of
          Some previous -> assertMsg "A valuation cannot restate a date already struck" (asOf > previous)
          None -> pure ()
        assertMsg "A valuation must identify its recipient positions" (length positionIds > 0)
        assertMsg "Duplicate recipient positions are not permitted" (dedup positionIds == positionIds)
        updated <- forA positionIds $ \positionId -> do
          position <- fetch positionId
          assertMsg "A position must belong to this fund and GP"
            (position.fundId == fundId && position.gp == gp)
          exercise positionId ApplyValuation with
            asOf; navPerUnit; distributionsPerUnit; feesAccruedPerUnit; basis
        newFund <- create this with latestValuation = Some asOf
        pure ValuationResult with fund = newFund; positions = updated

    nonconsuming choice PrepareDisclosure : ContractId DisclosureDraft
      with
        eventId : Text
        standardText : Text
        enhancedText : Text
        positionIds : [ContractId LpPosition]
      controller gp
      do
        assertMsg "A disclosure must identify its recipients" (length positionIds > 0)
        assertMsg "Duplicate recipient positions are not permitted" (dedup positionIds == positionIds)
        recipients <- forA positionIds $ \positionId -> do
          position <- fetch positionId
          assertMsg "A disclosure cannot use a position from another fund"
            (position.fundId == fundId && position.gp == gp)
          assertMsg "An exhausted position is not an active disclosure recipient" (position.units > 0.0)
          pure DisclosureRecipient with lp = position.lp; rights = position.rights
                                        policyReference = position.policyReference
        now <- getTime
        create DisclosureDraft with
          fundId; gp; reviewer; auditors; eventId; standardText; enhancedText
          recipients; preparedAt = now

template PositionProposal
  with
    fundId : Text
    fundName : Text
    gp : Party
    lp : Party
    auditors : [Party]
    rights : RightsTier
    policyReference : Text
    commitment : Decimal
    units : Decimal
    disclosureIntervalDays : Int
  where
    signatory gp
    observer lp
    ensure fundId /= "" && policyReference /= "" && commitment > 0.0 && units > 0.0 && disclosureIntervalDays > 0

    choice AcceptPosition : ContractId LpPosition
      controller lp
      do
        now <- getTime
        create LpPosition with
          fundId; fundName; gp; lp; auditors; rights; policyReference
          commitment; units; disclosureIntervalDays; admittedOn = now
          latestValuation = None; navPerUnit = 0.0

    choice RejectPosition : ()
      controller lp
      do pure ()

    choice WithdrawPosition : ()
      controller gp
      do pure ()

template LpPosition
  with
    fundId : Text
    fundName : Text
    gp : Party
    lp : Party
    auditors : [Party]
    rights : RightsTier
    policyReference : Text
    commitment : Decimal
    units : Decimal
    disclosureIntervalDays : Int
    admittedOn : Time
    latestValuation : Optional Time
    navPerUnit : Decimal
  where
    signatory gp, lp
    observer auditors
    ensure fundId /= "" && commitment > 0.0 && units >= 0.0 && policyReference /= "" && disclosureIntervalDays > 0

    choice ApplyValuation : ContractId LpPosition
      with
        asOf : Time
        navPerUnit : Decimal
        distributionsPerUnit : Decimal
        feesAccruedPerUnit : Decimal
        basis : Text
      controller gp
      do
        now <- getTime
        assertMsg "A valuation cannot be future-dated" (asOf <= now)
        assertMsg "A valuation needs a positive NAV and a stated basis"
          (navPerUnit > 0.0 && basis /= "" && distributionsPerUnit >= 0.0 && feesAccruedPerUnit >= 0.0)
        case latestValuation of
          Some previous -> assertMsg "A valuation cannot restate a date already struck" (asOf > previous)
          None -> pure ()
        create Valuation with
          fundId; gp; lp; auditors; asOf; navPerUnit
          distributionsPerUnit; feesAccruedPerUnit; basis; recordedAt = now
        create this with latestValuation = Some asOf; navPerUnit

    choice UpgradeRights : ContractId LpPosition
      with sideLetterReference : Text
      controller gp
      do
        assertMsg "Enhanced rights need a recorded side letter" (sideLetterReference /= "")
        create this with rights = Enhanced; policyReference = sideLetterReference

    -- Reserves units on this LP's position, never consumes the fund.
    -- This records an accepted request; payment/token settlement is separate.
    choice RequestRedemption : RedemptionResult
      with requestedUnits : Decimal
      controller lp
      do
        now <- getTime
        assertMsg "A redemption must fit the investor's available units"
          (requestedUnits > 0.0 && requestedUnits <= units)
        asOf <- case latestValuation of
          None -> abort "The fund contract refuses this redemption: no valuation has been disclosed"
          Some value -> pure value
        assertMsg "The fund contract refuses this redemption: the disclosed valuation is stale"
          (asOf <= now && now <= addRelTime asOf (days disclosureIntervalDays))
        remaining <- create this with units = units - requestedUnits
        request <- create Redemption with
          fundId; gp; lp; auditors; units = requestedUnits; navPerUnit
          valuationAsOf = asOf; requestedAt = now
        pure RedemptionResult with position = remaining; request

-- One valuation receipt per LP, without anyone else's identity or rights.
-- No edit choices. Ledger history still needs retention and a query index.
template Valuation
  with
    fundId : Text
    gp : Party
    lp : Party
    auditors : [Party]
    asOf : Time
    navPerUnit : Decimal
    distributionsPerUnit : Decimal
    feesAccruedPerUnit : Decimal
    basis : Text
    recordedAt : Time
  where
    signatory gp
    observer lp, auditors
    ensure navPerUnit > 0.0 && basis /= "" && asOf <= recordedAt && distributionsPerUnit >= 0.0 && feesAccruedPerUnit >= 0.0

template Redemption
  with
    fundId : Text
    gp : Party
    lp : Party
    auditors : [Party]
    units : Decimal
    navPerUnit : Decimal
    valuationAsOf : Time
    requestedAt : Time
  where
    signatory gp, lp
    observer auditors
    ensure units > 0.0 && navPerUnit > 0.0 && valuationAsOf <= requestedAt

template DisclosureDraft
  with
    fundId : Text
    gp : Party
    reviewer : Party
    auditors : [Party]
    eventId : Text
    standardText : Text
    enhancedText : Text
    recipients : [DisclosureRecipient]
    preparedAt : Time
  where
    signatory gp
    observer reviewer, auditors
    ensure gp /= reviewer && eventId /= "" && standardText /= "" && enhancedText /= "" && length recipients > 0

    choice ApproveAndPublish : [ContractId DisclosureReceipt]
      controller reviewer
      do
        now <- getTime
        receipts <- forA recipients $ \recipient -> do
          create DisclosureReceipt with
            fundId; gp; reviewer; auditors; eventId
            lp = recipient.lp; rights = recipient.rights
            policyReference = recipient.policyReference
            payload = if recipient.rights == Enhanced then enhancedText else standardText
            publishedAt = now
        create PublicationAudit with
          fundId; gp; reviewer; auditors; eventId; receipts
          preparedAt; publishedAt = now
        pure receipts

    choice RejectDisclosure : ()
      with reason : Text
      controller reviewer
      do
        assertMsg "Rejection needs a stated reason" (reason /= "")
        pure ()

    choice WithdrawDisclosure : ()
      controller gp
      do pure ()

template DisclosureReceipt
  with
    fundId : Text
    gp : Party
    reviewer : Party
    lp : Party
    auditors : [Party]
    eventId : Text
    rights : RightsTier
    policyReference : Text
    payload : Text
    publishedAt : Time
  where
    signatory gp, reviewer
    observer lp, auditors
    ensure eventId /= "" && payload /= "" && policyReference /= ""

template PublicationAudit
  with
    fundId : Text
    gp : Party
    reviewer : Party
    auditors : [Party]
    eventId : Text
    receipts : [ContractId DisclosureReceipt]
    preparedAt : Time
    publishedAt : Time
  where
    signatory gp, reviewer
    observer auditors
    ensure eventId /= "" && length receipts > 0 && preparedAt <= publishedAt

template MaterialEvent
  with
    fundId : Text
    gp : Party
    lp : Party
    auditors : [Party]
    eventId : Text
    detectedAt : Time
    impactLowPct : Decimal
    impactHighPct : Decimal
  where
    signatory gp
    observer lp, auditors
    ensure eventId /= "" && impactLowPct >= 0.0 && impactHighPct >= impactLowPct
